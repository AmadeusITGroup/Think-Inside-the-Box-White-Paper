						</defs>
						<g stroke="var(--border)" stroke-width="1">
							<line x1="56" y1="20" x2="540" y2="20" />
							<line x1="56" y1="80" x2="540" y2="80" />
							<line x1="56" y1="140" x2="540" y2="140" />
							<line x1="56" y1="200" x2="540" y2="200" />
