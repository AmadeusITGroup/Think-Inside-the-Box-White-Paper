						<text class="bar-tag" x="185" y="226">≈ 1</text>
						<text class="bar-tag bar-tag-value" x="395" y="18">≈ 30×</text>
						<text class="bar-label" x="185" y="278">Cost to ship docs</text>
						<text class="bar-label" x="395" y="278">Value of correct code</text>
					</svg>
